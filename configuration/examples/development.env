# Explizite lokale Entwicklungs-/Testvorlage. Externe Anbindungen und Hostintegration. Interne Architekturwerte stehen in Code und Compose.
APP_ENV=development
COMPOSE_PROJECT_NAME=cve-monitoring-dev
MOUNT_BASE=./.runtime
SECRETS_BASE=./.runtime
INGRESS_BIND_IP=127.0.0.1
INGRESS_HTTP_PORT=8080
INGRESS_HTTPS_PORT=8443
DASHBOARD_DOMAIN=dashboard.example.test
SMTP_HOST=
SMTP_PORT=587
SMTP_SENDER=cve-monitor@example.test
SMTP_USERNAME=
SMTP_PASSWORD=
TLS_DIR=./.runtime/development/pki

# Optional: DNS-01 über Cloudflare für die Dashboard-Domain.
# Nutzungsbedingungen: https://letsencrypt.org/repository/
LETSENCRYPT_ENABLED=false
LETSENCRYPT_EMAIL=
LETSENCRYPT_AGREE_TOS=false
CLOUDFLARE_API_TOKEN=
