# Externe Anbindungen und Hostintegration. Interne Architekturwerte stehen in Code und Compose.
# Servervorlage: Dashboard-Domain, Hostpfade und Let’s-Encrypt-Live-Ordner anpassen.
APP_ENV=production
COMPOSE_PROJECT_NAME=cve-monitoring-prod
MOUNT_BASE=/var/lib/cve-monitor/data
SECRETS_BASE=/var/lib/cve-monitor/secrets
INGRESS_BIND_IP=0.0.0.0
INGRESS_HTTP_PORT=80
INGRESS_HTTPS_PORT=443
DASHBOARD_DOMAIN=dashboard.example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_SENDER=cve-monitor@example.test
SMTP_USERNAME=
SMTP_PASSWORD=
TLS_DIR=/etc/letsencrypt/live/dashboard.example.org

# Optional: DNS-01 über Cloudflare für die Dashboard-Domain.
# Nutzungsbedingungen: https://letsencrypt.org/repository/
LETSENCRYPT_ENABLED=false
LETSENCRYPT_EMAIL=
LETSENCRYPT_AGREE_TOS=false
CLOUDFLARE_API_TOKEN=
