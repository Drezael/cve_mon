      "default": false,
      "title": "Exception Four Eyes",
      "type": "boolean"
    },
    "max_snapshot_age_hours": {
      "anyOf": [
        {
          "maximum": 8760,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Snapshot Age Hours"
    },
    "kev_floor": {
      "default": "high",
      "enum": [
