          "high",
          "medium",
          "low",
          "unrated"
        ]
      },
      "title": "Deadlines Hours",
      "type": "object"
    },
    "deadline_warning_hours": {
      "anyOf": [
        {
          "maximum": 8760,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline Warning Hours"
    }
  },
  "title": "Policy",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
