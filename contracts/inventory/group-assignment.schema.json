{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "group_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 500,
      "title": "Group Ids",
      "type": "array"
    },
    "version": {
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "group_ids"
  ],
  "title": "MembershipWrite",
  "type": "object"
}
