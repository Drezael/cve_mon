{
  "additionalProperties": false,
  "properties": {
    "display_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "environment": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment"
    },
    "criticality": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Criticality",
      "type": "string"
    },
    "exposure": {
      "default": "unknown",
      "enum": [
        "internal",
        "restricted",
        "internet_exposed",
        "unknown"
      ],
      "title": "Exposure",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "display_name",
    "request_id"
  ],
  "title": "ServerCreate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
