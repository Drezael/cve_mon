{
  "version": "1.3",
  "kind": "architecture-contract",
  "networks": {
    "cve_ingress": {
      "internal": false,
      "purpose": "Nur Nginx: HTTP/80 ausschlie\u00dflich kontrollierte HTTPS-Weiterleitung; HTTPS/443"
    },
    "cve_internal": {
      "internal": true,
      "purpose": "Authentifizierte interne APIs"
    },
    "cve_data": {
      "internal": true,
      "purpose": "PostgreSQL auf TCP 5432"
    },
    "cve_outbound": {
      "internal": false,
      "purpose": "Direkte verifizierte HTTPS- und SMTP-Verbindungen ohne Egress-Proxy"
    }
  },
  "services": {
    "cve-nginx": {
      "networks": [
        "cve_ingress",
        "cve_internal"
      ],
      "database_roles": []
    },
    "cve-postgres": {
      "networks": [
        "cve_data"
      ],
      "database_roles": [
        "postgres_owner"
      ]
    },
    "cve-n8n": {
      "networks": [
        "cve_internal",
        "cve_data",
        "cve_outbound"
      ],
      "database_roles": [
        "n8n_app"
      ]
    },
    "cve-mail-relay": {
      "networks": [
        "cve_internal",
        "cve_outbound"
      ],
      "database_roles": []
    },
    "cve-api": {
      "networks": [
        "cve_internal",
        "cve_data"
      ],
      "database_roles": [
        "api_reader",
        "api_ingest",
        "api_security",
        "dashboard_admin",
        "dashboard_preferences"
      ]
    },
    "cve-dashboard": {
      "networks": [
        "cve_internal"
      ],
      "database_roles": []
    },
    "cve-importer": {
      "networks": [
        "cve_internal",
        "cve_data",
        "cve_outbound"
      ],
      "database_roles": [
        "importer"
      ]
    },
    "cve-enricher": {
      "networks": [
        "cve_internal",
        "cve_data",
        "cve_outbound"
      ],
      "database_roles": [
        "enricher"
      ]
    },
    "cve-inventory": {
      "networks": [
        "cve_internal",
        "cve_data"
      ],
      "database_roles": [
        "inventory_processor"
      ]
    },
    "cve-matcher": {
      "networks": [
        "cve_internal",
        "cve_data"
      ],
      "database_roles": [
        "matcher"
      ]
    },
    "cve-findings": {
      "networks": [
        "cve_internal",
        "cve_data"
      ],
      "database_roles": [
        "findings_writer"
      ]
    },
    "cve-reporter": {
      "networks": [
        "cve_internal",
        "cve_data"
      ],
      "database_roles": [
        "reporter"
      ]
    },
    "cve-event-dispatcher": {
      "networks": [
        "cve_internal",
        "cve_data"
      ],
      "database_roles": [
        "event_dispatcher"
      ]
    },
    "cve-notification": {
      "networks": [
        "cve_internal",
        "cve_data"
      ],
      "database_roles": [
        "notification"
      ]
    },
    "cve-service-status": {
      "networks": [
        "cve_internal",
        "cve_data"
      ],
      "database_roles": [
        "status_probe"
      ]
    },
    "cve-mailhog": {
      "networks": [
        "cve_outbound"
      ],
      "database_roles": []
    }
  },
  "group_write_roles": [
    "dashboard_admin"
  ],
  "inventory_roles": [
    "api_ingest",
    "inventory_processor"
  ],
  "forbidden_inventory_writes": [
    "inventory.servers",
    "inventory.server_groups",
    "inventory.server_group_memberships",
    "dashboard.group_order",
    "dashboard.server_order"
  ],
  "public_ports": {
    "cve-nginx": [
      80,
      443
    ]
  },
  "runtime_configuration": false
}
