@contextmanager
def lifecycle(config: Config) -> Iterator[None]:
    """Serialize public lifecycle commands without blocking n8n host-controller work."""
    target = config.root / ".runtime/application" / config.project
    target.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(target / "lifecycle.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "a+") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def start(config: Config) -> None:
    from scripts.application.build import LABEL, build, fingerprint

    if config.values["APP_ENV"] == "production":
        from scripts.database import manage as db
        from scripts.infrastructure import mail
        from scripts.infrastructure.acme import bootstrap
        from scripts.infrastructure.manage import certificate_preflight

        bootstrap(config)
        ensure_certificates(config)
        certificate_preflight(config)
        db.prepare(config)
        if (db.workdir(config) / "private/development.json").exists() or (
            mail.directory(config) / "development-only"
        ).exists():
            raise LaunchError("Serverbetrieb akzeptiert keine bestehende Entwicklungs-PKI.")
    frontend(config)
    # The existing builder reuses the unchanged shared image; vendor images are never built.
    build(config)
    current = run([*docker_command(), "image", "inspect", APPLICATION_IMAGE]).stdout
    desired = json.loads(current)[0]
    if desired["Config"]["Labels"].get(LABEL) != fingerprint(config.root):
        raise LaunchError("Das Anwendungsimage entspricht nicht den aktuellen Quellen.")
    if healthy(config):
        ids = compose(
            config, ["ps", "-q", "cve-api", "cve-processing", "cve-sources"]
        ).stdout.split()
        images = json.loads(run([*docker_command(), "inspect", *ids]).stdout)
        if (
            all(item["Image"] == desired["Id"] for item in images)
            and current_schema(config)
            and current_compose(config)
            and workflows_ready(config)
        ):
            from scripts.dashboard.manage import activate

            deployed = config.directory / "dashboard/index.html"
            built = config.root / "services/dashboard/dist/index.html"
            if not deployed.is_file() or deployed.read_bytes() != built.read_bytes():
                activate(config)
            if not controller_ready(config):
                from scripts.automation_executor.agent import start as start_control

                start_control(config)
            print("CVE Monitor läuft bereits; bestehende Container bleiben unverändert.")
            urls(config)
            return
    print("CVE Monitor mit Datenbankmigrationen und Namespace-Freigaben starten …", flush=True)
    provision(config)
    from scripts.infrastructure.acme import start as start_acme

    start_acme(config)
    if not healthy(config):
        raise LaunchError("Der Start ist nicht vollständig gesund. Bitte status und logs prüfen.")
    urls(config)


