def setup_environment() -> None:
    """Create only the project-local environment using the existing hash-locked files."""
    interpreter = os.environ.get("PYTHON", "python3.12")
    try:
        subprocess.run(
            [interpreter, "-c", "import sys; assert sys.version_info[:2] == (3, 12)"], check=True
        )
    except (OSError, subprocess.SubprocessError):
        raise RuntimeError(
            "Python 3.12 erforderlich; Interpreter nicht gefunden oder ungeeignet."
        ) from None
    environment = ROOT / ".venv"
    python = environment / "bin/python"
    if environment.exists() or environment.is_symlink():
        if (
            environment.is_symlink()
            or not (environment / "pyvenv.cfg").is_file()
            or not python.is_file()
        ):
            raise RuntimeError("Vorhandene .venv ist keine gültige lokale Umgebung.")
    else:
        subprocess.run([interpreter, "-m", "venv", str(environment)], check=True)
    subprocess.run(
        [
            str(python),
            "-c",
            "import sys; assert sys.version_info[:2] == (3, 12) and sys.prefix != sys.base_prefix",
        ],
        check=True,
    )
    for lock in ["native-build.txt", "runtime.txt", "dev.txt"]:
        command = [str(python), "-m", "pip", "install", "--require-hashes"]
        if lock != "native-build.txt":
            command.append("--no-build-isolation")
        subprocess.run([*command, "-r", str(ROOT / "requirements" / lock)], cwd=ROOT, check=True)
    packages = [
        "packages/cve_common",
        *[
            "services/" + s
            for s in [
                "notification",
                "findings",
                "api",
                "event-dispatcher",
                "inventory",
                "importer",
                "matcher",
                "enricher",
                "automation",
            ]
        ],
    ]
    editable = [argument for package in packages for argument in ["-e", package]]
    subprocess.run(
        [str(python), "-m", "pip", "install", "--no-deps", "--no-build-isolation", *editable],
        cwd=ROOT,
        check=True,
    )
    subprocess.run([str(python), "-m", "pip", "check"], cwd=ROOT, check=True)
    print("Python-Umgebung bereit. .env für Produktivbetrieb konfigurieren, dann ./cve_mon start")


def select_interpreter() -> None:
    if sys.argv[1:] == ["setup"]:
        setup_environment()
        raise SystemExit(0)
    python = ROOT / ".venv/bin/python"
    if Path(sys.prefix).resolve() != (ROOT / ".venv").resolve():
        if python.is_file():
            os.execv(str(python), [str(python), str(ROOT / "cve_mon"), *sys.argv[1:]])
        if not sys.argv[1:] or sys.argv[1] in {"help", "--help", "-h"}:
            print(
                "CVE Monitor: ./cve_mon [--sudo] BEFEHL\n"
                "Befehle: setup, config, start, build, status, health, logs, stop, down, reset\n"
                "Zuerst ./cve_mon setup ausführen."
            )
            raise SystemExit(0)
        raise RuntimeError("Lokale Python-Umgebung fehlt. Zuerst ./cve_mon setup ausführen.")


if __name__ == "__main__":
    try:
        select_interpreter()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        message = str(error) if isinstance(error, RuntimeError) else type(error).__name__
        print("Einrichtung fehlgeschlagen: " + message, file=sys.stderr)
        raise SystemExit(
            error.returncode if isinstance(error, subprocess.CalledProcessError) else 1
        ) from None

