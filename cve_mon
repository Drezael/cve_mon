def stop(config: Config, *, remove: bool) -> None:
    from scripts.automation_executor.agent import exclusive

    with exclusive(config):
        stop_controller(config)
        compose(
            config,
            [
                "stop",
                "--timeout",
                "45",
                *SERVICES,
                *(["cve-certbot"] if config.values.get("LETSENCRYPT_ENABLED") == "true" else []),
            ],
        )
        if remove:
            compose(config, ["down", "--timeout", "45"])
    print(
        "Container entfernt; Bind-Mount-Daten und Konfiguration bleiben erhalten."
        if remove
        else "CVE Monitor gestoppt; Daten und Container bleiben erhalten."
    )


def reset_paths(config: Config) -> list[Path]:
    """Reset private repository configuration plus this project's external mutable data."""
    from scripts.database.manage import workdir
    from scripts.infrastructure.mounts import data_paths

    paths = [
        (
            config.secrets_base / "storage" / config.project
            if name == "storage"
            else config.runtime_directory(name)
        )
        for name in (
            "application",
            "automation-executor",
            "services",
            "status",
            "nginx",
            "automation",
            "ansible",
            "inventory-processor",
            "cve-importer",
            "cve-enricher",
            "cve-matcher",
            "cve-findings",
            "notifications",
            "n8n",
            "mail",
            "envoy",
            "storage",
            "infrastructure",
        )
    ]
    if (
        not workdir(config).is_relative_to(config.secrets_base)
        or workdir(config).parent == config.secrets_base
    ):
        raise LaunchError("Reset benötigt PG_WORK_DIR innerhalb von SECRETS_BASE.")
    paths += [
        config.secrets_base / "notifications" / (config.project + "-signing"),
        workdir(config),
    ]
    if any(other != path and other.is_relative_to(path) for path in paths for other in paths):
        raise LaunchError("Reset verweigert: Laufzeitpfade überlappen sich.")
    for data in data_paths(config):
        if not any(data.is_relative_to(path) for path in paths):
            paths.append(data)
    for path in paths:
        for part in (path, *path.parents):
            if part.is_symlink():
                raise LaunchError("Reset verweigert: Laufzeitpfad enthält einen Symlink.")
        if path.exists() and not path.is_dir():
            raise LaunchError("Reset verweigert: Laufzeitpfad ist kein Verzeichnis.")
    return paths


def reset_volumes(config: Config) -> list[str]:
    """Refuse name collisions with volumes belonging to another deployment."""
    available = set(
        run([*docker_command(), "volume", "ls", "--format", "{{.Name}}"]).stdout.splitlines()
    )
    names = []
    for logical in ("postgres_data", "postgres_tls", "cve_postfix_queue", "cve_mailhog_data"):
        name = config.project + "_" + logical
        if name not in available:
            continue
        item = json.loads(run([*docker_command(), "volume", "inspect", name]).stdout)[0]
        labels = item.get("Labels") or {}
        if (
            labels.get("com.docker.compose.project") != config.project
            or labels.get("com.docker.compose.volume") != logical
        ):
            raise LaunchError("Reset verweigert: Fremdes Volume unter erwartetem Namen: " + name)
        names.append(name)
    return names


def reset(config: Config, *, confirmation: str | None) -> None:
    """Destroy this development project's live data only after explicit confirmation."""
    from scripts.automation_executor.agent import exclusive
    from scripts.infrastructure.storage import directory as storage_directory
    from scripts.infrastructure.storage import remove as remove_storage

    if config.values["APP_ENV"] != "development":
        raise LaunchError("Datenreset ist ausschließlich für Entwicklungsprojekte erlaubt.")
    if confirmation != config.project:
        raise LaunchError(
            "Datenreset löscht alle Projektdaten. Erforderlich: reset --confirm " + config.project
        )
    if config.compose_overrides:
        raise LaunchError("Datenreset mit Compose-Overrides ist nicht erlaubt.")
    own_project(config)
    paths = reset_paths(config)
    reset_volumes(config)
    with exclusive(config):
        stop_controller(config)
        compose(
            config,
            [
                "stop",
                "--timeout",
                "45",
                *SERVICES,
                *(["cve-certbot"] if config.values.get("LETSENCRYPT_ENABLED") == "true" else []),
            ],
        )
        compose(config, ["down", "--timeout", "45"])
        # Revalidate after shutdown; a failed stop/down must never reach deletion.
        paths = reset_paths(config)
        volumes = reset_volumes(config)
        if volumes:
            run([*docker_command(), "volume", "rm", *volumes])
        remove_storage(config)
        for path in paths:
            if path in {
                storage_directory(config),
                config.secrets_base / "storage" / config.project,
            }:
                continue
            if not path.exists():
                continue
            if path.parent.name in {"application", "automation-executor"}:
                # Retain lock inodes so waiting lifecycle/erasure operations stay serialized.
                for child in path.iterdir():
                    if child.name in {"lifecycle.lock", "erasure.lock"}:
                        continue
                    if child.is_dir() and not child.is_symlink():
                        shutil.rmtree(child)
                    else:
                        child.unlink()
            else:
                try:
                    shutil.rmtree(path)
                except PermissionError:
                    from scripts.infrastructure.storage import remove_tree

                    remove_tree(config, path)
    print("Datenreset abgeschlossen: " + config.project + ".")
    print("Neu initialisieren: ./cve_mon start (gegebenenfalls mit --sudo und --env-file).")


def mail_test(config: Config, operation: str) -> None:
    from scripts.hardening.runtime_images import ensure
    from scripts.infrastructure.images import REFERENCES

    if config.values["APP_ENV"] != "development":
        raise LaunchError("Mailtests sind ausschließlich im Entwicklungsprofil erlaubt.")
    overlay = config.root / "infrastructure/compose/mail-test.yml"
    test_config = replace(config, compose_overrides=(*config.compose_overrides, overlay))
    if operation == "start":
        from scripts.infrastructure.manage import resolved, validate_model

        errors = validate_model(
            resolved(test_config),
            True,
            config.root,
            mount_base=config.mount_base,
            secrets_base=config.secrets_base,
        )
        if errors:
            raise LaunchError("Ungültiges Mailtest-Profil: " + "; ".join(errors))
        ensure(REFERENCES["mailhog"])
        compose(test_config, ["up", "-d", "--no-deps", "--wait", "cve-mailhog"], managed=False)
        print("Mailtest aktiv: http://127.0.0.1:8025 (SMTP intern: mailhog.cve.test:1025)")
    elif operation == "stop":
        compose(test_config, ["rm", "--stop", "--force", "cve-mailhog"])
        print("Mailtest beendet; aufgefangene Testnachrichten bleiben erhalten.")
    elif operation == "status":
        print(compose(test_config, ["ps", "--all", "cve-mailhog"]).stdout, end="")
    else:
        print(compose(test_config, ["logs", "--tail", "100", "cve-mailhog"]).stdout, end="")


def logs(config: Config, services: list[str], *, follow: bool, tail: int) -> None:
    aliases = {s.removeprefix("cve-"): s for s in SERVICES}
    allowed = (
        *SERVICES,
        *(["cve-certbot"] if config.values.get("LETSENCRYPT_ENABLED") == "true" else []),
    )
    aliases.update({"postfix": "cve-mail-relay", "certbot": "cve-certbot"})
    targets = [
        aliases.get(s, physical(s if s.startswith("cve-") else "cve-" + s)) for s in services
    ]
    if any(s not in allowed for s in targets):
        raise LaunchError(
            "Unbekannter Dienst. Erlaubt: "
            + ", ".join(SERVICES)
            + " (auch logische Worker wie matcher)."
        )
    arguments = [
        "logs",
        "--tail",
        str(tail),
        *(["--follow"] if follow else []),
        *dict.fromkeys(targets),
    ]
    if not follow:
        print(compose(config, arguments).stdout, end="")
        return
    # Streaming logs must not use the captured-output controller's 120-second limit.
    prefix = docker_command()
    if prefix[0] == "sudo":
        prefix = ["sudo", "-n", "--preserve-env=" + ",".join(sorted(config.values)), "docker"]
    command = [
        *prefix,
        "compose",
        "--project-name",
        config.project,
        "-f",
        str(config.root / "compose.yml"),
    ]
    if config.values["APP_ENV"] == "development":
        command += ["-f", str(config.root / "infrastructure/compose/development.yml")]
    if config.values.get("LETSENCRYPT_ENABLED") == "true":
        command += ["-f", str(config.root / "infrastructure/compose/letsencrypt.yml")]
    subprocess.run(
        [*command, *arguments], cwd=config.root, env={**os.environ, **config.values}, check=True
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="CVE Monitor – Compose-Deployment für Entwicklung und Server",
        epilog=(
            "Setup: ./cve_mon setup. Microservice-Neustarts erfolgen intern über n8n im Dashboard."
        ),
    )
    parser.add_argument(
        "--sudo", action="store_true", help="Passwortloses sudo ausschließlich für Docker verwenden"
    )
    parser.add_argument(
        "--env-file", type=Path, help="Andere Konfigurationsdatei; bestehende .env bleibt erhalten"
    )
    commands = parser.add_subparsers(dest="action")
    for command, help_text in [
        ("start", "Gesamten Stack kontrolliert starten"),
        ("up", "Alias für start"),
    ]:
        commands.add_parser(command, help=help_text)
    for command, description in [
        ("setup", "Lokale Python-3.12-Umgebung einrichten"),
        ("config", "Compose ohne Ausgabe von Secrets validieren"),
        ("check", "Alias für config"),
        ("build", "Gemeinsames Anwendungsimage und Dashboard bauen"),
        ("status", "Containerstatus anzeigen"),
        ("health", "Gesundheit der sieben Kerndienste und des Hostcontrollers prüfen"),
        ("ps", "Alias für status"),
        ("stop", "Stack stoppen, Daten behalten"),
        ("down", "Container/Netze entfernen, Datenvolumes behalten"),
        ("help", "Diese Hilfe anzeigen"),
    ]:
        commands.add_parser(command, help=description)
    reset_parser = commands.add_parser("reset", help="Alle Daten des Entwicklungsprojekts löschen")
    reset_parser.add_argument(
        "--confirm", metavar="PROJEKTNAME", help="Projektname als Löschbestätigung"
    )
    capture = commands.add_parser(
        "mail-test", help="Optionalen MailHog ausschließlich für Mailtests verwalten"
    )
    capture.add_argument("operation", choices=["start", "stop", "status", "logs"])
    log = commands.add_parser("logs", help="Logs anzeigen")
    log.add_argument("services", nargs="*")
    log.add_argument("-f", "--follow", action="store_true", help="Logs fortlaufend streamen")
    log.add_argument("--tail", type=int, default=100)
    args = parser.parse_args(argv)
    if args.action in {None, "help"}:
        parser.print_help()
        return 0
    if args.action == "setup":
        setup_environment()
        return 0
    if args.sudo:
        os.environ["CVE_DOCKER_SUDO"] = "1"
    if args.action == "logs" and not 0 <= args.tail <= 10000:
        parser.error("--tail muss zwischen 0 und 10000 liegen")
    config: Config | None = None
    try:
        config = load_config(env_file=args.env_file)
        if args.env_file:
            os.environ["CVE_ENV_FILE"] = str(args.env_file.resolve())
        if args.action == "reset" and args.confirm != config.project:
            raise LaunchError(
                "Datenreset löscht alle Projektdaten. Erforderlich: reset --confirm "
                + config.project
            )
        docker_ready(daemon=args.action not in {"config", "check"})
        if args.action in {"config", "check"}:
            from scripts.infrastructure.manage import resolved, validate_model

            errors = validate_model(
                resolved(config),
                config.values["APP_ENV"] == "development",
                config.root,
                mount_base=config.mount_base,
                secrets_base=config.secrets_base,
            )
            if errors:
                raise LaunchError("Ungültiges Compose-Modell: " + "; ".join(errors))
            print("Compose-Konfiguration OK: " + config.project)
        elif args.action in {"status", "ps"}:
            print(compose(config, ["ps", "--all"]).stdout, end="")
            urls(config)
        elif args.action == "health":
            if (
                not healthy(config)
                or not consistent_images(config)
                or not controller_ready(config)
                or not current_schema(config)
            ):
                raise LaunchError("Container, Hostcontroller oder Datenbankstand nicht bereit.")
            print("Gesund: sieben Kerndienste, Hostcontroller und Datenbank bereit.")
        elif args.action == "mail-test":
            own_project(config)
            with lifecycle(config):
                mail_test(config, args.operation)
        elif args.action == "logs":
            logs(config, args.services, follow=args.follow, tail=args.tail)
        else:
            if args.action != "build":
                own_project(config)
            if args.action in {"start", "up", "build"}:
                from scripts.infrastructure.mounts import prepare as prepare_mounts
                from scripts.infrastructure.secrets import prepare as prepare_secrets

                config = replace(config, initialize_secrets=True)
                prepare_secrets(config)
                prepare_mounts(config)
            with lifecycle(config):
                if args.action in {"start", "up"}:
                    start(config)
                elif args.action == "build":
                    from scripts.application.build import build

                    frontend(config, force=True)
                    build(config)
                elif args.action == "reset":
                    reset(config, confirmation=args.confirm)
                else:
                    stop(config, remove=args.action == "down")
        return 0
    except KeyboardInterrupt:
        return 130
    except (LaunchError, ValueError, OSError, subprocess.SubprocessError) as error:
        print(
            "Fehler: "
            + (
                process_failure(error, config)
                if isinstance(error, subprocess.CalledProcessError)
                else str(error)
                if isinstance(error, (LaunchError, ValueError))
                else type(error).__name__
            ),
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
