def provision(config: Config) -> None:
    from cve_common.deployment import GROUPS, PORTS

    from scripts.application.manage import prepare
    from scripts.database import manage as db
    from scripts.deployment.contracts import Environment
    from scripts.deployment.orchestration import start_runtime
    from scripts.infrastructure.manage import (
        render,
        resolved,
        validate_model,
    )
    from scripts.services import manage as api

    ids = compose(config, ["ps", "--all", "-q"]).stdout.split()
    if ids:
        rows = json.loads(run([*docker_command(), "inspect", *ids]).stdout)
        if any(
            item["Config"]["Labels"].get("com.docker.compose.service") in set(PORTS) - set(GROUPS)
            for item in rows
        ):
            raise LaunchError("Legacy-Container erkannt; vorhandenen Migrationspfad verwenden.")
    if validate_model(
        resolved(config),
        config.values["APP_ENV"] == "development",
        config.root,
        mount_base=config.mount_base,
        secrets_base=config.secrets_base,
    ):
        raise LaunchError("Ungültiges Compose-Modell; keine Dienste gestartet.")
    db.prepare(config)
    ensure_certificates(config)
    compose(config, ["up", "-d", "--wait", "--wait-timeout", "90", "cve-postgres"])
    db.provision(config)
    db.migrate(config)
    prepare(config, "cve-processing")
    prepare(config, "cve-sources")
    api.prepare(config)
    render(config)
    target = Environment(
        config.root / ".runtime/application" / config.project / "environment.json",
        {"kind": "production" if config.values["APP_ENV"] == "production" else "staging"},
        config,
    )
    start_runtime(target, config.root)


def consistent_images(config: Config) -> bool:
    ids = compose(config, ["ps", "-q", "cve-api", "cve-processing", "cve-sources"]).stdout.split()
    if len(ids) != 3:
        return False
    rows = json.loads(run([*docker_command(), "inspect", *ids]).stdout)
    return len({item["Image"] for item in rows}) == 1


def current_schema(config: Config) -> bool:
    from alembic.config import Config as AlembicConfig
    from alembic.script import ScriptDirectory

    from scripts.database import manage as db

    with db.connect(config) as connection:
        actual = connection.execute("SELECT version_num FROM public.alembic_version").fetchone()
    head = ScriptDirectory.from_config(
        AlembicConfig(str(config.root / "database/alembic.ini"))
    ).get_current_head()
    return bool(actual and actual["version_num"] == head)


def current_compose(config: Config) -> bool:
    expected = dict(
        line.split()
        for line in compose(config, ["config", "--hash", "*"], daemon=False).stdout.splitlines()
        if line.strip()
    )
    ids = compose(config, ["ps", "--all", "-q"]).stdout.split()
    if not ids:
        return False
    rows = json.loads(run([*docker_command(), "inspect", *ids]).stdout)
    return all(
        item["Config"]["Labels"].get("com.docker.compose.config-hash")
        == expected.get(item["Config"]["Labels"].get("com.docker.compose.service"))
        for item in rows
    )


def workflows_ready(config: Config) -> bool:
    from scripts.database import manage as db

    definitions = {
        item["id"]: item
        for path in (config.root / "workflows/n8n").glob("*.json")
        for item in [json.loads(path.read_text())]
    }
    if not definitions:
        return False
    with db.connect(config, database="n8n") as connection:
        exists = connection.execute(
            "SELECT to_regclass('public.workflow_entity') AS name"
        ).fetchone()
        if not exists or not exists["name"]:
            return False
        rows = connection.execute(
            'SELECT id,name,nodes,connections,settings,active,"versionId","activeVersionId" '
            "FROM public.workflow_entity WHERE id=ANY(%s)",
            (sorted(definitions),),
        ).fetchall()
    return len(rows) == len(definitions) and all(
        row["active"]
        and row["activeVersionId"] == row["versionId"]
        and all(row[key] == definitions[row["id"]][key] for key in ("name", "nodes", "connections"))
        and all(
            (row["settings"] or {}).get(key) == value
            for key, value in definitions[row["id"]].get("settings", {}).items()
        )
        for row in rows
    )


def controller_ready(config: Config) -> bool:
    from cve_common.host_control import command

    try:
        response = asyncio.run(
            command(config.secrets_base / "services" / config.project, {"operation": "health"})
        )
        return response.get("status") == 200
    except (OSError, ValueError, TimeoutError):
        return False


def own_project(config: Config) -> None:
    """Refuse a reused project name belonging to a different checkout or Compose file."""
    ids = run(
        [
            *docker_command(),
            "ps",
            "-aq",
            "--filter",
            "label=com.docker.compose.project=" + config.project,
        ]
    ).stdout.split()
    if not ids:
        return
    rows = json.loads(run([*docker_command(), "inspect", *ids]).stdout)
    for item in rows:
        labels = item["Config"]["Labels"]
        files = labels.get("com.docker.compose.project.config_files", "").split(",")
        if (
            labels.get("com.docker.compose.project.working_dir") != str(config.root)
            or str(config.root / "compose.yml") not in files
        ):
            raise LaunchError(
                "Der Compose-Projektname gehört zu einem anderen Deployment; "
                "keine Änderung ausgeführt."
            )


