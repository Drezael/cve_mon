class LaunchError(Exception):
    """Actionable messages which contain no configuration secrets."""


def process_failure(error: subprocess.CalledProcessError, config: Config | None) -> str:
    """Show captured diagnostics without command arguments, stdout or credentials."""
    from cve_common.logging.redaction import redact, register_secret
    from pydantic import SecretStr

    from scripts.database.manage import workdir

    if config is not None:
        for name in ("SMTP_PASSWORD", "CLOUDFLARE_API_TOKEN"):
            if password := config.values.get(name):
                register_secret(SecretStr(password))
        try:
            for path in (workdir(config) / "secrets").glob("*.password"):
                if not path.is_symlink() and (password := path.read_text().strip()):
                    register_secret(SecretStr(password))
        except OSError:
            # Without access to credentials, omit potentially sensitive diagnostics.
            return f"Werkzeug fehlgeschlagen (Exit-Code {error.returncode}); Diagnose unterdrückt."
    message = f"Werkzeug fehlgeschlagen (Exit-Code {error.returncode})."
    if isinstance(error.stderr, str) and error.stderr.strip():
        message += "\n" + str(redact(error.stderr)).strip()[:4000]
    return message


def docker_ready(*, daemon: bool) -> None:
    if not shutil.which("docker"):
        raise LaunchError("Docker mit Compose-Plugin fehlt.")
    try:
        run(["docker", "compose", "version"])
        if daemon:
            run([*docker_command(), "info", "--format", "{{.ServerVersion}}"])
    except (OSError, subprocess.SubprocessError):
        raise LaunchError(
            "Docker/Compose nicht erreichbar. Bei freigegebenem passwortlosem sudo: "
            "./cve_mon --sudo BEFEHL (oder CVE_DOCKER_SUDO=1)."
        ) from None


def frontend_fingerprint(root: Path) -> str:
    base = root / "services/dashboard"
    paths = list((base / "src").rglob("*")) + [
        base / name
        for name in [
            "package.json",
            "package-lock.json",
            "index.html",
            "tsconfig.json",
            "vite.config.ts",
            "toolchain.toml",
        ]
    ]
    digest = hashlib.sha256()
    for path in sorted(p for p in paths if p.is_file()):
        digest.update(str(path.relative_to(base)).encode())
        digest.update(path.read_bytes())
    return digest.hexdigest()


def frontend(config: Config, *, force: bool = False) -> None:
    from scripts.dashboard.manage import npm
    from scripts.deployment.contracts import atomic

    base = config.root / "services/dashboard"
    marker = config.root / ".runtime/application" / config.project / "dashboard-build.json"
    fingerprint = frontend_fingerprint(config.root)
    built = base / "dist/index.html"
    if not force and built.is_file():
        if marker.is_file() and json.loads(marker.read_text()).get("fingerprint") == fingerprint:
            return
        # Accept an existing build made with the documented dashboard tools.
        sources = [p for p in (base / "src").rglob("*") if p.is_file()]
        sources += [
            base / name
            for name in [
                "package.json",
                "package-lock.json",
                "index.html",
                "tsconfig.json",
                "vite.config.ts",
                "toolchain.toml",
            ]
        ]
        if not marker.exists() and all(
            p.stat().st_mtime_ns <= built.stat().st_mtime_ns for p in sources
        ):
            atomic(marker, {"fingerprint": fingerprint})
            return
    print("Dashboard bauen (gesperrte lokale Node-/npm-Werkzeuge) …", flush=True)
    npm(config.root, "ci", "--ignore-scripts")
    npm(config.root, "run", "build")
    atomic(marker, {"fingerprint": fingerprint})


def healthy(config: Config) -> bool:
    raw = compose(config, ["ps", "--all", "--format", "json"]).stdout
    rows = [json.loads(line) for line in raw.splitlines() if line.strip()]
    if any(row["Service"] not in (*SERVICES, *OPTIONAL_SERVICES) for row in rows):
        return False
    if config.values.get("LETSENCRYPT_ENABLED") == "true" and not any(
        row["Service"] == "cve-certbot"
        and row.get("State") == "running"
        and row.get("Health") == "healthy"
        for row in rows
    ):
        return False
    rows = [row for row in rows if row["Service"] in SERVICES]
    return {r["Service"] for r in rows} == set(SERVICES) and all(
        r.get("Health") == "healthy" and r.get("State") == "running" for r in rows
    )


