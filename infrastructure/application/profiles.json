    "mounts": [
      {
        "source": "${SECRETS_BASE:-./.runtime}/cve-importer/${COMPOSE_PROJECT_NAME:-cve-monitoring}",
        "target": "/run/cve-importer",
        "read_only": true
      },
      {
        "source": "${MOUNT_BASE:-./.runtime}/cve-importer/${COMPOSE_PROJECT_NAME:-cve-monitoring}/scratch",
        "target": "/work/importer",
        "read_only": false
      },
      {
        "source": "${SECRETS_BASE:-./.runtime}/cve-enricher/${COMPOSE_PROJECT_NAME:-cve-monitoring}",
        "target": "/run/cve-enricher",
        "read_only": true
      },
      {
        "source": "${MOUNT_BASE:-./.runtime}/cve-enricher/${COMPOSE_PROJECT_NAME:-cve-monitoring}/scratch",
        "target": "/work/enricher",
        "read_only": false
      },
      {
        "source": "${SECRETS_BASE:-./.runtime}/automation/${COMPOSE_PROJECT_NAME:-cve-monitoring}",
        "target": "/run/cve-dispatcher",
        "read_only": true
