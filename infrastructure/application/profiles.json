  "cve-sources": {
    "roles": [
      "cve-automation"
    ],
    "environment_keys": [
      "CVE_APPLICATION_PROFILE",
      "CVE_ANSIBLE_APP_ENV",
      "CVE_ANSIBLE_DATABASE__HOST",
      "CVE_ANSIBLE_DATABASE__USERNAME",
      "CVE_ANSIBLE_DATABASE__PASSWORD_FILE",
      "CVE_ANSIBLE_DATABASE__CA_FILE",
      "CVE_ANSIBLE_KEYRING_FILE",
      "CVE_ANSIBLE_WORK_DIRECTORY",
      "CVE_ANSIBLE_CONCURRENCY",
      "CVE_ANSIBLE_HTTP_PORT"
    ],
    "mounts": [
      {
        "source": "${SECRETS_BASE:-./.runtime}/ansible/${COMPOSE_PROJECT_NAME:-cve-monitoring}",
        "target": "/run/cve-ansible",
        "read_only": true
      },
      {
        "source": "./.runtime/application/${COMPOSE_PROJECT_NAME:-cve-monitoring}",
        "target": "/run/cve-application",
        "read_only": true
      }
    ]
  }
}
