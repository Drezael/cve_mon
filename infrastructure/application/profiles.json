        "source": "${SECRETS_BASE:-./.runtime}/cve-findings/${COMPOSE_PROJECT_NAME:-cve-monitoring}",
        "target": "/run/cve-findings",
        "read_only": true
      },
      {
        "source": "${SECRETS_BASE:-./.runtime}/notifications/${COMPOSE_PROJECT_NAME:-cve-monitoring}",
        "target": "/run/cve-notification",
        "read_only": true
      },
      {
        "source": "./.runtime/application/${COMPOSE_PROJECT_NAME:-cve-monitoring}",
        "target": "/run/cve-application",
        "read_only": true
      }
    ]
