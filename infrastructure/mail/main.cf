compatibility_level = 3.10
myhostname = cve-mail-relay
myorigin = cve-mail-relay.invalid
mydestination =
relay_domains =
inet_protocols = ipv4
inet_interfaces = all
mynetworks =
local_transport = error:local delivery disabled
local_recipient_maps =
alias_maps =
alias_database =
transport_maps =
sender_dependent_relayhost_maps =
smtp_fallback_relay =
relayhost = [127.0.0.1]:1
queue_directory = /var/spool/postfix
data_directory = /var/lib/postfix
maillog_file =
maillog_file_prefixes = /dev
syslog_name = cve-postfix
smtpd_banner = $myhostname ESMTP
smtpd_delay_reject = yes
smtpd_helo_required = yes
smtpd_peername_lookup = no
disable_vrfy_command = yes
smtpd_sasl_auth_enable = no
smtpd_tls_security_level = encrypt
smtpd_tls_req_ccert = yes
smtpd_tls_ask_ccert = yes
smtpd_tls_fingerprint_digest = sha256
smtpd_tls_CAfile = /run/postfix/client-ca.crt
smtpd_tls_cert_file = /run/postfix/server.crt
smtpd_tls_key_file = /run/postfix/server.key
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_mandatory_ciphers = high
smtpd_tls_received_header = no
tls_append_default_CA = no
relay_clientcerts = texthash:/run/postfix/client-certificates
smtpd_relay_restrictions = permit_tls_clientcerts, reject
smtpd_sender_restrictions = reject_non_fqdn_sender, check_ccert_access texthash:/run/postfix/client-senders, reject
smtpd_recipient_restrictions = reject_non_fqdn_recipient, check_recipient_access texthash:/run/postfix/recipients, reject
smtpd_data_restrictions = reject_unauth_pipelining
header_checks = regexp:/run/postfix/header-checks
smtp_tls_security_level = secure
smtp_tls_CAfile = /run/postfix/upstream-ca.crt
smtp_tls_policy_maps = texthash:/run/postfix/tls-policy
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_mandatory_ciphers = high
smtp_tls_loglevel = 1
smtp_sasl_auth_enable = yes
# Map path only, never credentials.
# pragma: allowlist nextline secret
smtp_sasl_password_maps = texthash:/run/postfix/sasl-passwd
smtp_sasl_security_options = noanonymous,noplaintext
smtp_sasl_tls_security_options = noanonymous,noplaintext
smtp_sasl_tls_verified_security_options = noanonymous
smtp_sasl_mechanism_filter = plain, login
smtp_dns_support_level = enabled
smtp_host_lookup = native
smtp_bind_address = 0.0.0.0
smtp_connect_timeout = 5s
smtp_helo_timeout = 5s
smtp_starttls_timeout = 5s
smtp_mail_timeout = 10s
smtp_rcpt_timeout = 10s
smtp_data_init_timeout = 10s
smtp_data_xfer_timeout = 30s
smtp_data_done_timeout = 10s
smtpd_timeout = 30s
smtpd_client_connection_count_limit = 8
smtpd_client_connection_rate_limit = 30
smtpd_client_message_rate_limit = 30
smtpd_client_recipient_rate_limit = 100
smtpd_client_event_limit_exceptions =
smtpd_recipient_limit = 20
message_size_limit = 1048576
queue_minfree = 10485760
maximal_queue_lifetime = 5d
bounce_queue_lifetime = 1d
minimal_backoff_time = 60s
maximal_backoff_time = 3600s
queue_run_delay = 60s
delay_warning_time = 0h
bounce_size_limit = 1
notify_classes =
soft_bounce = no
smtp_destination_concurrency_limit = 2
default_process_limit = 20
smtpd_forbid_unauth_pipelining = yes

smtp_connection_cache_on_demand = no
smtp_connection_cache_destinations =
